# Copy this file to .streamlit/secrets.toml and fill in your real
# connection string. secrets.toml is gitignored -- never commit your
# actual password.
#
# Use the Session Pooler URI from Supabase (Project -> Connect ->
# Session pooler -> URI), with the password filled in and NOT wrapped
# in brackets.

DATABASE_URL = "postgresql://postgres.xxxxxxxxxxxx:[email protected]:5432/postgres"
